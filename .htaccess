# === DMC .htaccess ===
# IMPORTANT: deploy the HTTPS redirect + HSTS below ONLY after a valid TLS
# certificate is installed for the domain, otherwise the site becomes unreachable.

SetEnv PHPRC /home/customer/www/dmc-im.com/public_html/php.ini
AddHandler application/x-httpd-php83 .php .php5 .php4 .php3

RewriteEngine On

# Force HTTPS (requires a working TLS certificate).
RewriteCond %{HTTPS} !=on
RewriteRule ^(.*)$ https://www.dmc-im.com/$1 [L,R=301]

# Canonicalize apex -> www (over HTTPS).
RewriteCond %{HTTP_HOST} ^dmc-im\.com [NC]
RewriteRule ^(.*)$ https://www.dmc-im.com/$1 [L,R=301]

# --- Security response headers ---
<IfModule mod_headers.c>
    # HSTS only takes effect over HTTPS; safe to leave enabled once TLS works.
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    # Disable the legacy, buggy XSS auditor (per current OWASP guidance).
    Header always set X-XSS-Protection "0"
    # Drop browser features this app never uses (defense-in-depth).
    Header always set Permissions-Policy "geolocation=(), camera=(), microphone=(), payment=(), usb=()"
    # Content-Security-Policy (S10/SEC-26). eval() has been removed (dashboard.php), so no
    # 'unsafe-eval'. 'unsafe-inline' is still required because the app uses inline <script>/<style>
    # throughout; a future hardening can move to per-request nonces to drop it. External origins
    # are the CDNs actually used (jsDelivr/Google/cdnjs/Bootstrap). Validated on PHP 8.3: dashboard
    # Chart.js + the register/reset password meter (jQuery+zxcvbn) all work under this policy.
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://ajax.googleapis.com https://cdnjs.cloudflare.com; style-src 'self' 'unsafe-inline' https://maxcdn.bootstrapcdn.com https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com https://maxcdn.bootstrapcdn.com data:; img-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'self'; form-action 'self'"
</IfModule>

# --- Block direct web access to sensitive files ---
<FilesMatch "(?i)(\.(sql|md|log|gitignore|docx)$|^php_errorlog$|^config\.local\.php$|^\.env)">
    Require all denied
</FilesMatch>
# Hide the .git directory if it is ever present in the web root.
RedirectMatch 404 (?i)/\.git

<IfModule mod_expires.c>
    ExpiresActive on
    ExpiresDefault                                      "access plus 6 months"
  # CSS
    ExpiresByType text/css                              "access plus 1 year"
  # HTML components (HTCs)
    ExpiresByType text/x-component                      "access plus 0 seconds"
  # HTML
    ExpiresByType text/html                             "access plus 1 minute"
  # JavaScript
    ExpiresByType application/javascript                "access plus 1 year"
    ExpiresByType application/x-javascript              "access plus 1 year"
  # Manifest files
    ExpiresByType application/x-web-app-manifest+json   "access plus 0 seconds"
    ExpiresByType text/cache-manifest                   "access plus 0 seconds"
  # Media
    ExpiresByType audio/ogg                             "access plus 1 year"
    ExpiresByType image/gif                             "access plus 1 year"
    ExpiresByType image/jpg                             "access plus 1 year"
    ExpiresByType image/jpeg                            "access plus 1 year"
    ExpiresByType image/png                             "access plus 1 year"
    ExpiresByType image/svg                             "access plus 1 year"
    ExpiresByType image/svg+xml                         "access plus 1 year"
    ExpiresByType video/mp4                             "access plus 1 year"
    ExpiresByType video/ogg                             "access plus 1 year"
    ExpiresByType video/webm                            "access plus 1 year"
    ExpiresByType image/x-icon                          "access plus 1 year"
    ExpiresByType application/pdf                       "access plus 1 year"
    ExpiresByType application/x-shockwave-flash         "access plus 1 year"
  # XML
    ExpiresByType text/xml                              "access plus 0 seconds"
    ExpiresByType application/xml                       "access plus 0 seconds"
  # Web feeds
    ExpiresByType application/atom+xml                  "access plus 1 hour"
    ExpiresByType application/rss+xml                   "access plus 1 hour"
  # Web fonts
    ExpiresByType application/font-woff                 "access plus 1 year"
    ExpiresByType application/font-woff2                "access plus 1 year"
    ExpiresByType application/vnd.ms-fontobject         "access plus 1 year"
    ExpiresByType application/x-font-ttf                "access plus 1 year"
    ExpiresByType font/opentype                         "access plus 1 year"
</IfModule>
