APP_NAME="DMC Internal Medicine"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8001

# Deployed build identity, surfaced by GET /health as app.version. Set to the git SHA at deploy
# time (e.g. `git rev-parse --short HEAD`); empty reads as "unknown".
APP_VERSION=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# Comma-separated previous APP_KEYs kept valid while rotating the key (blank = none).
APP_PREVIOUS_KEYS=

# Maintenance-mode driver (file | cache); APP_MAINTENANCE_STORE names the cache store for `cache`.
APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

# PRODUCTION: APP_ENV=production, APP_DEBUG=false, LOG_CHANNEL=daily (rotated), LOG_LEVEL=warning,
# SESSION_SECURE_COOKIE=true (behind TLS), SESSION_ENCRYPT=true, and keep APP_TIMEZONE on the
# hospital's zone (date-typed columns are timezone-naive; "today" boundaries drift if app/DB zones differ).
LOG_CHANNEL=stack
# Production: LOG_STACK=daily,stderr — `stderr` emits JSON lines to the container runtime (OBS-01),
# which is what survives a redeploy; `daily` keeps the on-disk file for local reading.
LOG_STACK=single
LOG_LEVEL=debug
# Days of rotated files the `daily` channel keeps.
LOG_DAILY_DAYS=14
# Channel for PHP/Laravel deprecation notices (null = discard) and whether to include a trace.
LOG_DEPRECATIONS_CHANNEL=null
LOG_DEPRECATIONS_TRACE=false
APP_TIMEZONE=Asia/Riyadh

# Error monitoring (recommended for production): composer require sentry/sentry-laravel,
# then set the DSN — the SDK stays inert while SENTRY_DSN is empty.
SENTRY_DSN=

# Content-Security-Policy mode for the SecurityHeaders middleware: enforce (default, blocking) |
# report (Content-Security-Policy-Report-Only, observe only) | off (no CSP header at all).
CSP_MODE=enforce

# RFC 9116 security.txt `Contact:` — a URI (mailto:/https:/tel:) for the hospital's monitored
# security inbox. Served at /.well-known/security.txt; keep SECURITY.md (repo root + laravel/) in step.
SECURITY_CONTACT=mailto:info@dmc-im.com

# Application database (the clean Laravel schema)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=dmc_laravel
DB_USERNAME=root
DB_PASSWORD=
# Optional MySQL knobs: a single DSN instead of the parts above, a unix socket, charset/collation,
# and TLS to the DB server (setting the CA path turns it on).
# DB_URL=
# DB_SOCKET=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci
# MYSQL_ATTR_SSL_CA=
# Driver-specific and unused with mysql — sqlite / pgsql / sqlsrv respectively:
# DB_FOREIGN_KEYS=true
# DB_SSLMODE=prefer
# DB_ENCRYPT=yes
# DB_TRUST_SERVER_CERTIFICATE=false

# Read-only source DB for `php artisan legacy:import` (the original / renovated data)
LEGACY_DB_DATABASE=dmc_prod

# Off-box encrypted DB backups (DATA-02). The backup itself is made by host cron
# (scripts/backup/db-backup.py, config in /root/.dmc-backup.env — see docs/BACKUP-AND-RESTORE.md);
# the app only VERIFIES it: `backup:verify` (daily) reads {prefix}/LATEST.json from this bucket
# using the AUDIT_S3_ENDPOINT/REGION/ACCESS_KEY/SECRET credentials and alerts admins in-app when
# the newest backup is older than 26h, missing, or unreadable. Separate bucket from the audit
# archive so its lifecycle/retention can differ. Defaults: dmc-db-backups / db-backups/dmc_demo.
DB_BACKUP_S3_BUCKET=
# DB_BACKUP_S3_PREFIX=db-backups/dmc_demo

# `database` (the `sessions` table exists from the base migration): sessions survive a redeploy and
# the session-revocation paths (password reset, MFA reset, self password change) actually work —
# with `file` they deleted DB rows no session lived in (SEC-04). Production switched 2026-09-03.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Cookie flags: Secure (HTTPS only — true in production), HttpOnly, SameSite (lax | strict | none),
# expire when the browser closes, and the CHIPS partitioned attribute.
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_EXPIRE_ON_CLOSE=false
SESSION_PARTITIONED_COOKIE=false
# Only for SESSION_DRIVER=database | redis: connection / table / store overrides.
# SESSION_CONNECTION=
# SESSION_TABLE=sessions
# SESSION_STORE=

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
# Where failed jobs are recorded (database-uuids = the failed_jobs table).
QUEUE_FAILED_DRIVER=database-uuids
# Only for QUEUE_CONNECTION=database | redis | beanstalkd | sqs:
# DB_QUEUE_CONNECTION= / DB_QUEUE_TABLE=jobs / DB_QUEUE=default / DB_QUEUE_RETRY_AFTER=90
# REDIS_QUEUE_CONNECTION=default / REDIS_QUEUE=default / REDIS_QUEUE_RETRY_AFTER=90
# BEANSTALKD_QUEUE_HOST=localhost / BEANSTALKD_QUEUE=default / BEANSTALKD_QUEUE_RETRY_AFTER=90
# SQS_PREFIX= / SQS_QUEUE=default / SQS_SUFFIX=

# Cache. NOTE: the cron user and the web user must share this store — the scheduler liveness beacon
# (`scheduler:heartbeat`, read by GET /health) is written by cron and read by the web process.
# `database` (the `cache` table exists): the dashboard cache survives a redeploy and a second app
# replica would share it (PERF-07). Production switched 2026-09-03.
CACHE_STORE=database
# Key prefix (avoids collisions when several apps share one cache backend).
CACHE_PREFIX=
# Only for CACHE_STORE=database | redis | dynamodb, or a custom file disk/path:
# DB_CACHE_CONNECTION= / DB_CACHE_TABLE=cache / DB_CACHE_LOCK_CONNECTION= / DB_CACHE_LOCK_TABLE=
# REDIS_CACHE_CONNECTION=cache / REDIS_CACHE_LOCK_CONNECTION=default / REDIS_CACHE_DB=1
# DYNAMODB_CACHE_TABLE=cache / DYNAMODB_ENDPOINT=
# CACHE_STORAGE_DISK= / CACHE_STORAGE_PATH=

# Redis (only read when a redis driver is selected for cache / session / queue)
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
# REDIS_URL= / REDIS_USERNAME= / REDIS_DB=0 / REDIS_PREFIX= / REDIS_CLUSTER=redis / REDIS_PERSISTENT=false
# REDIS_MAX_RETRIES=3 / REDIS_BACKOFF_ALGORITHM=decorrelated_jitter / REDIS_BACKOFF_BASE=100 / REDIS_BACKOFF_CAP=1000

# Memcached (only for CACHE_STORE=memcached)
MEMCACHED_HOST=127.0.0.1
# MEMCACHED_PORT=11211 / MEMCACHED_USERNAME= / MEMCACHED_PASSWORD= / MEMCACHED_PERSISTENT_ID=

# Mail — `log` locally (verification/reset codes land in storage/logs). Production uses the SMTP
# relay; host/port/credentials can also be set at runtime in Control → System (stored encrypted).
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@dmc-im.com"
MAIL_FROM_NAME="${APP_NAME}"
# MAIL_URL= (single DSN alternative) / MAIL_EHLO_DOMAIN= / MAIL_LOG_CHANNEL= / MAIL_SENDMAIL_PATH=
# Third-party mail APIs, only if MAIL_MAILER is switched to them:
# POSTMARK_API_KEY= / POSTMARK_MESSAGE_STREAM_ID= / RESEND_API_KEY=

# Off-box audit-log archive for `audit:ship` (hourly). S3-compatible, path-style — the intended
# target is OCI Object Storage in the Riyadh region. Leave all five unset and shipping no-ops;
# set all five to enable. Never commit real values.
AUDIT_S3_ENDPOINT=
AUDIT_S3_REGION=me-riyadh-1
AUDIT_S3_BUCKET=
AUDIT_S3_ACCESS_KEY=
AUDIT_S3_SECRET=

# Destination bucket for the off-box encrypted database backup job (bucket name only; credentials
# come from the job's own environment). Reserved for that job — nothing else reads it.
DB_BACKUP_S3_BUCKET=

# AWS / S3 filesystem disk (only if FILESYSTEM_DISK=s3)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false
# AWS_ENDPOINT= / AWS_URL=

# Log sinks used only by the matching LOG_CHANNEL / LOG_STACK entries:
# PAPERTRAIL_URL= / PAPERTRAIL_PORT= / LOG_PAPERTRAIL_HANDLER=
# LOG_SLACK_WEBHOOK_URL= / LOG_SLACK_USERNAME="Laravel Log" / LOG_SLACK_EMOJI=:boom:
# LOG_STDERR_FORMATTER= / LOG_SYSLOG_FACILITY=

# Slack notification channel (unused by default):
# SLACK_BOT_USER_OAUTH_TOKEN= / SLACK_BOT_USER_DEFAULT_CHANNEL=

# Auth defaults (stock Laravel — leave as-is):
# AUTH_GUARD=web / AUTH_MODEL=App\Models\User / AUTH_PASSWORD_BROKER=users
# AUTH_PASSWORD_RESET_TOKEN_TABLE=password_reset_tokens / AUTH_PASSWORD_TIMEOUT=10800

# Inertia: server-side rendering is off (the app is client-rendered); `encrypt` protects page data
# kept in the browser's history state (see config/inertia.php).
INERTIA_SSR_ENABLED=false
INERTIA_ENCRYPT_HISTORY=false
# INERTIA_SSR_URL=http://127.0.0.1:13714 / INERTIA_SSR_RUNTIME= / INERTIA_SSR_ENSURE_BUNDLE_EXISTS=
# INERTIA_SSR_ENSURE_RUNTIME_EXISTS= / INERTIA_SSR_THROW_ON_ERROR=

VITE_APP_NAME="${APP_NAME}"
