# --- Secrets: never commit ---
config.local.php
.env
.env.*

# --- PHI / database dumps: never commit ---
Demo.sql
*.sql
*.sql.gz
!migrations/*.sql
# structure-only (mysqldump --no-data) CI fixture — verified ZERO data rows, safe to commit:
!tools/ci/schema.sql

# --- Runtime logs ---
php_errorlog
**/php_errorlog
*.log

# --- Runtime assets: COMMITTED so the repo is self-contained / clone-deployable ---
# This app has no package manager; jQuery/Bootstrap/Chart.js/Select2 (vendor/),
# AdminLTE + the logo (dist/), and FontAwesome web fonts (css/webfonts/, referenced
# by css/css/all.min.css) are all required at runtime. They are vendored copies and
# are tracked in git so a fresh `git clone` is a working deploy. Verified free of
# secrets/PHI before committing.

# --- FontAwesome source/extra assets NOT used at runtime (no code references) ---
css/svgs/
css/sprites/
css/less/
css/scss/
css/metadata/

# --- AdminLTE build sources, unused at runtime ("orderes" is the upstream typo) ---
work-orderes/

# --- Local dev tooling (never deployed / committed) ---
dev-router.php
.claude/launch.json
tools/stats-baselines/
# local chart snapshots (regenerable; delivered to the user, not repo artifacts):
tools/e2e/snaps/

# --- OS / editor cruft ---
Thumbs.db
.DS_Store
*.swp
